node_modules
dist/
*.log
.DS_Store
.env
.env.*
# The plaintext key `vf config typesafe key` writes: the user root can BE a working tree
# (`VF_USER_VIBEFLOW_ROOT`, or a home directory under the repo), and `.env`/`.env.*` above
# do not match this name.
typesafe.env*
# The health records an enabled run writes - same working-tree user root: `typesafe-health.json`,
# `.goal.json`, `.probe.json`, and proper-lockfile `<name>.lock` siblings. Breaker state only
# (no key material), but they must never be committed from a repo-rooted user root either.
typesafe-health*.json*
.e2e-workspace*
test-results
playwright-report
landing/.astro
.firebase/
screenshots/

# Tool-generated agent config. AGENTS.md is now a VibeFlow-generated engine file
# (committed as part of this repo's reference example); the rest stay ignored.
.agents/skills/
.github/skills/
.claude/*
!.claude/settings.json
!.claude/rules/
!.claude/rules/**
!.claude/CLAUDE.md
.opencode/

# Generated by `vf init` / `vf hooks emit`: per-machine absolute CLI/workspace
# paths. Same class as .claude/ above — never commit; `vf init` regenerates them.
/.mcp.json
/.codex/hooks.json
/.github/copilot-hooks.json
/.github/hooks/

# VibeFlow-generated per-engine agent files (regenerated by vf init).
# Engine dirs are views; canonical is .vibeflow/agents/ (future).
.codex/agents/
.claude/agents/
.github/agents/

# Tool session state / dispatch artifacts. Not source.
.hermes/
# Local vibeflow dispatch workunit state (no leading dot).
claude/
# But the reference templates under templates/ are committed source.
!templates/claude/
# lcov reports regenerated by `bun run check` (see scripts/coverage-gate.cjs).
coverage/
*.lcov
*.lcov.info
.ui-port
*/.vibeflow/.ui-port
.vibeflow/knowledge/memory.db*
.agents/agents/

# Local Orca worktree tooling (per-developer, not project config)
.worktreeinclude
orca.yaml

# Local worktrees (never commit worktree contents)
.worktrees/
