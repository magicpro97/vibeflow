---
import SEO from "../components/SEO.astro";

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
}

const { title, description, canonicalPath = "/" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} canonicalPath={canonicalPath} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="nav-bar">
      <div class="nav-inner container">
        <a class="nav-logo" href="/">VibeFlow</a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/wiki/">Wiki</a>
          <a href="https://github.com/magicpro97/vibeflow">GitHub</a>
        </nav>
      </div>
    </header>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #081018;
    --bg-elev: #0d1621;
    --bg-panel: #111d2a;
    --bg-panel-strong: #122232;
    --border: rgba(124, 166, 187, 0.18);
    --border-strong: rgba(124, 166, 187, 0.3);
    --text: #edf6ff;
    --text-dim: #a2b4c9;
    --text-faint: #708297;
    --accent: #59e1cb;
    --accent-strong: #96fff0;
    --accent-grad: linear-gradient(135deg, #59e1cb 0%, #78f3e0 100%);
    --accent-surface: rgba(89, 225, 203, 0.12);
    --code-bg: #09121b;
    --mono: ui-monospace, "SF Mono", "Cascadia Code", "JetBrains Mono", Menlo,
      Consolas, monospace;
    --sans: "Segoe UI", ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
    --maxw: 1180px;
    --radius: 18px;
    --shadow: 0 30px 90px rgba(0, 0, 0, 0.28);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    line-height: 1.65;
    font-size: 17px;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
    background-image:
      radial-gradient(52% 42% at 86% 0%, rgba(89, 225, 203, 0.16) 0%, transparent 70%),
      radial-gradient(38% 32% at 8% 12%, rgba(89, 225, 203, 0.08) 0%, transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.015), transparent 22%);
    background-attachment: fixed;
    background-repeat: no-repeat;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.02) 0%,
      transparent 38%,
      rgba(89, 225, 203, 0.03) 68%,
      transparent 100%
    );
    mask-image: radial-gradient(circle at center, black, transparent 82%);
  }

  main {
    position: relative;
  }

  img,
  video {
    max-width: 100%;
  }

  ::selection {
    background: rgba(89, 225, 203, 0.22);
    color: var(--text);
  }

  h1,
  h2,
  h3 {
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0;
  }

  p {
    margin: 0;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  code,
  pre {
    font-family: var(--mono);
  }

  .skip-link {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--accent);
    color: #062420;
    padding: 0.6rem 1rem;
    border-radius: 0 0 8px 0;
    z-index: 100;
    font-weight: 600;
  }

  .skip-link:focus {
    left: 0;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 6px;
  }

  .container {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: 1.35rem;
  }

  .nav-bar {
    border-bottom: 1px solid var(--border);
    background: rgba(8, 16, 24, 0.78);
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.95rem;
    gap: 1rem;
  }

  .nav-logo {
    font-weight: 700;
    font-size: 1.02rem;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .nav-logo:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 1.35rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--text-dim);
    font-size: 0.93rem;
    font-weight: 500;
  }

  .nav-links a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }

    body {
      background-attachment: scroll;
    }

    body::before {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding-inline: 1rem;
    }

    .nav-inner {
      padding-block: 0.85rem;
    }

    .nav-links {
      gap: 1rem;
    }
  }
</style>
