---
import Layout from "../layouts/Layout.astro";

const repo = "https://github.com/magicpro97/vibeflow";
const npmUrl = "https://www.npmjs.com/package/@magicpro97/vibeflow";

const capabilities = [
  {
    title: "AI-first Home",
    body: "Persistent conversation Home keeps the session rail, capability search, and settings inside one durable local surface.",
    detail: "Discovery, continuity, action review",
    className: "capability-card capability-card-home",
  },
  {
    title: "Ordered message queue",
    body: "Rapid sends stay FIFO, the latest queued message stays editable, and the browser never outruns queue authority.",
    detail: "Exact queue ownership and replay",
    className: "capability-card capability-card-queue",
  },
  {
    title: "Canonical context handoff",
    body: "Fresh or unproved sessions receive canonical public context. Exact resumes keep native history and receive only new user and peer deltas.",
    detail: "Native history, proof-bound deltas",
    className: "capability-card capability-card-handoff",
  },
  {
    title: "Typed quotes and reactions",
    body: "Quote one to eight visible messages and keep reactions as typed conversation data, not prompt syntax.",
    detail: "Public quote refs and restrained social signals",
    className: "capability-card capability-card-quotes",
  },
  {
    title: "Dynamic capability fabric",
    body: "Skills, MCP, tools, hooks, roles, and engine settings resolve into reviewed installs, repair, rollback, and status.",
    detail: "One install path for every supported CLI",
    className: "capability-card capability-card-fabric",
  },
  {
    title: "Owned process recovery",
    body: "PID, exact process-start identity, host, and operation stay VF-owned. Windows Job Objects are kernel-contained; POSIX process groups prove cooperative lineage.",
    detail: "Exact proof before orphan takeover",
    className: "capability-card capability-card-recovery",
  },
];

const steps = [
  {
    cmd: "vf init",
    title: "Seed shared context",
    text: "Write canonical context, engine instructions, and the vf skill into every supported CLI.",
  },
  {
    cmd: "vf doctor --probe",
    title: "Probe real readiness",
    text: "Confirm installed engines and live round-trips; report owned CLI recovery state without guessing.",
  },
  {
    cmd: "vf orchestrate --yes",
    title: "Run through one authority",
    text: "Dispatch work, keep queue and evidence bounded, and route reviewed actions through the same host contract.",
  },
  {
    cmd: "vf verify",
    title: "Hold done until proof lands",
    text: "Gate completion on typecheck, lint, tests, confidence, evidence, and scope.",
  },
];

const demoHighlights = [
  {
    title: "Persistent Home",
    body: "Conversation, settings, and install review stay in one surface instead of bouncing between modal flows.",
  },
  {
    title: "Durable queue",
    body: "Queued sends, edits, and handoff state survive restarts without inventing a second winner.",
  },
  {
    title: "Exact installs",
    body: "Capability requests move from natural language to review, approval, operation, and audited result.",
  },
  {
    title: "Proof before done",
    body: "Verification is part of the run, not a promise added after the screenshot.",
  },
];

const skillHighlights = [
  "Seed one skill and one canonical context set across Claude Code, Codex, Copilot, OpenCode, and Antigravity.",
  "Review a capability install inside the same conversation, then choose the exact tools that should receive it.",
  "Keep repair and rollback in Home instead of letting package state drift in hidden side paths.",
];

const reliabilityNotes = [
  {
    title: "Bun 1.4 runtime",
    body: "The CLI, local web console, and landing deploy from one Bun based toolchain with Node compatible output.",
  },
  {
    title: "Owned lock identity",
    body: "Queue claims and capability writes bind PID, process-start identity, host, operation, and nonce. Live or unprovable owners fail closed.",
  },
  {
    title: "Reported drift",
    body: "Doctor and status surface manual, unsupported, orphaned, stale, and needs recovery states instead of silently claiming them.",
  },
];
---

<Layout
  title="VibeFlow | Local-first harness for AI CLIs"
  description="Local-first npm CLI and web console that connects AI CLIs, keeps Home and context handoff durable, reviews capability installs, and verifies before done."
>
  <main id="main">
    <section class="hero container">
      <div class="hero-copy">
        <p class="eyebrow">Local-first harness</p>
        <h1>
          <span>Connect every AI CLI.</span>
          <span class="hero-accent">Keep the handoff exact.</span>
        </h1>
        <p class="hero-lede">
          Persistent Home, durable queue, canonical handoff, and owned recovery stay local.
        </p>
        <div class="cta">
          <a class="btn btn-primary" href={repo}>View on GitHub</a>
          <a class="btn btn-ghost" href={npmUrl}>npm package</a>
        </div>
      </div>
      <div class="hero-stage">
        <img
          src="/demo-poster.jpg"
          alt="VibeFlow conversation Home and orchestration preview"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    </section>

    <section class="container section" aria-labelledby="demo-h">
      <div class="section-copy">
        <div class="install">
          <code>npx @magicpro97/vibeflow</code>
        </div>
        <h2 id="demo-h" class="section-h">Watch the harness run end to end</h2>
        <p class="section-lede">
          The same runtime plans, edits, verifies, and records evidence without leaving the local surface.
        </p>
      </div>
      <div class="demo-frame">
        <div class="demo-player">
          <video
            src="/demo.mp4"
            poster="/demo-poster.jpg"
            controls
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="VibeFlow orchestration demo video"
          ></video>
        </div>
        <div class="demo-rail" aria-label="Demo highlights">
          {demoHighlights.map((item) => (
            <article class="demo-item">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="container section" aria-labelledby="features-h">
      <div class="section-copy">
        <h2 id="features-h" class="section-h">Capability fabric for local AI work</h2>
        <p class="section-lede">
          Home, queue, handoff, quotes, installs, and repair all use one exact authority path.
        </p>
      </div>
      <div class="capability-grid">
        {capabilities.map((item) => (
          <article class={item.className}>
            <span>{item.detail}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="container section" aria-labelledby="how-h">
      <div class="section-copy">
        <h2 id="how-h" class="section-h">One path from prompt to proof</h2>
        <p class="section-lede">
          The CLI and the browser stay on the same contract from intake to verification.
        </p>
      </div>
      <ol class="process-flow">
        {steps.map((step) => (
          <li class="process-item">
            <code class="step-cmd">{step.cmd}</code>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="container section" aria-labelledby="skill-h">
      <div class="skill-layout">
        <div
          class="terminal"
          role="img"
          aria-label="Terminal showing npx @magicpro97/vibeflow init and the vf skill command"
        >
          <div class="term-bar"><span></span><span></span><span></span></div>
          <pre><code><span class="prompt">$</span> npx @magicpro97/vibeflow init
<span class="dim">Seed shared context and sync the vf skill into every supported CLI</span>
  <span class="ok">✓</span> claude
  <span class="ok">✓</span> codex
  <span class="ok">✓</span> copilot
  <span class="ok">✓</span> opencode
  <span class="ok">✓</span> antigravity

<span class="dim"># inside Claude Code, Codex, Copilot, or OpenCode</span>
<span class="prompt">&gt;</span> Refactor the auth middleware + vf
<span class="prompt">&gt;</span> /vf</code></pre>
        </div>
        <div class="skill-copy">
          <h2 id="skill-h" class="section-h">Install the same workflow into every CLI</h2>
          <p class="section-lede">
            <code class="step-cmd">vf init</code> seeds one shared skill, then Home can review capability
            installs and choose exact targets before anything changes.
          </p>
          <div class="skill-list">
            {skillHighlights.map((item) => (
              <p>{item}</p>
            ))}
          </div>
          <p class="section-link">
            Learn more in the <a href="/wiki/skills_system">Skills system</a> reference.
          </p>
        </div>
      </div>
    </section>

    <section class="container section" aria-labelledby="term-h">
      <div class="section-copy">
        <h2 id="term-h" class="section-h">Recovery stays explicit</h2>
        <p class="section-lede">
          Bun 1.4 runs the same CLI and web console. Doctor and status report drift, manual setup, orphaned
          markers, and repair paths without guessing.
        </p>
      </div>
      <div class="reliability-layout">
        <div class="command-stack" aria-label="Key commands">
          <div class="command-row">
            <span>Install locally</span>
            <code>bun install</code>
          </div>
          <div class="command-row">
            <span>Open the harness</span>
            <code>npx @magicpro97/vibeflow</code>
          </div>
          <div class="command-row">
            <span>Probe engines</span>
            <code>vf doctor --probe</code>
          </div>
          <div class="command-row">
            <span>Repair owned CLI state</span>
            <code>vf doctor --fix</code>
          </div>
          <div class="command-row">
            <span>Verify before done</span>
            <code>vf verify</code>
          </div>
        </div>
        <div class="reliability-notes">
          {reliabilityNotes.map((item) => (
            <article class="reliability-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <footer class="container footer">
      <div>
        <strong>VibeFlow</strong>
        <span class="dim"> Local-first harness for AI CLIs.</span>
      </div>
      <nav class="footer-links" aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={npmUrl}>npm</a>
        <a href="https://opensource.org/licenses/MIT">MIT License</a>
        <a href="https://linhngo.dev">Linh Ngo</a>
      </nav>
    </footer>
  </main>
</Layout>

<style>
  .section {
    padding-block: clamp(4.5rem, 9vw, 6.75rem);
  }

  .section-copy {
    max-width: 43rem;
    margin-bottom: 2rem;
  }

  .section-h {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .section-lede {
    margin-top: 1rem;
    color: var(--text-dim);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 42rem;
  }

  .section-link {
    margin-top: 1.35rem;
    color: var(--text-dim);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: end;
    min-height: calc(100dvh - 76px);
    padding-top: clamp(3rem, 7vw, 4.75rem);
    padding-bottom: 2.5rem;
  }

  .hero-copy {
    max-width: 34rem;
  }

  .eyebrow {
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .hero h1 {
    font-size: clamp(3rem, 6vw, 5.2rem);
    font-weight: 800;
  }

  .hero h1 span {
    display: block;
  }

  .hero-accent {
    color: var(--accent-strong);
  }

  .hero-lede {
    margin-top: 1.25rem;
    max-width: 28rem;
    color: var(--text-dim);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .hero-stage {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
      var(--bg-panel);
    box-shadow: var(--shadow);
    isolation: isolate;
  }

  .hero-stage img {
    width: 100%;
    display: block;
    aspect-ratio: 15 / 11;
    object-fit: cover;
  }

  .hero-stage::before,
  .hero-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero-stage::before {
    background:
      linear-gradient(180deg, rgba(8, 16, 24, 0) 52%, rgba(8, 16, 24, 0.28) 100%),
      radial-gradient(circle at 18% 18%, rgba(89, 225, 203, 0.18), transparent 32%);
  }

  .hero-stage::after {
    inset: -12% auto -12% -24%;
    width: 46%;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0),
      rgba(255, 255, 255, 0.03),
      rgba(89, 225, 203, 0.18),
      rgba(255, 255, 255, 0.03),
      rgba(255, 255, 255, 0)
    );
    filter: blur(18px);
    transform: rotate(10deg);
    opacity: 0.6;
  }

  .install {
    margin-bottom: 1rem;
    display: inline-flex;
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.78rem 1.15rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .install code {
    color: var(--text);
    font-size: 0.96rem;
  }

  .install code::before {
    content: '$ ';
    color: var(--accent);
  }

  .cta {
    margin-top: 2rem;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.78rem 1.45rem;
    border-radius: var(--radius);
    font-weight: 600;
    border: 1px solid transparent;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .btn:hover {
    text-decoration: none;
    transform: translateY(-1px);
  }

  .btn-primary {
    background: var(--accent);
    color: #062420;
    box-shadow: 0 18px 36px rgba(89, 225, 203, 0.15);
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--text);
    background: rgba(13, 22, 33, 0.72);
  }

  .btn-ghost:hover {
    border-color: var(--accent);
  }

  .demo-frame {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.55fr);
    gap: 1rem;
    align-items: stretch;
  }

  .demo-player {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    background: #081018;
    border: 1px solid var(--border);
    min-height: 100%;
  }

  .demo-player video {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .demo-rail {
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
      var(--bg-elev);
    padding: 1rem 1.1rem;
    display: grid;
    gap: 1rem;
  }

  .demo-item {
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(124, 166, 187, 0.12);
  }

  .demo-item:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .demo-item h3,
  .capability-card h3,
  .process-item h3,
  .reliability-card h3 {
    font-size: 1.08rem;
    margin-bottom: 0.45rem;
  }

  .demo-item p,
  .capability-card p,
  .process-item p,
  .skill-list p,
  .reliability-card p {
    color: var(--text-dim);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .capability-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .capability-card {
    position: relative;
    overflow: hidden;
    background: var(--bg-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.45rem;
    min-height: 220px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .capability-card span {
    display: inline-block;
    color: var(--accent-strong);
    font-family: var(--mono);
    font-size: 0.78rem;
    margin-bottom: 1rem;
  }

  .capability-card h3 {
    font-size: 1.34rem;
    margin-bottom: 0.7rem;
    max-width: 14rem;
  }

  .capability-card::before {
    content: "";
    position: absolute;
    inset: auto -10% -18% auto;
    width: 190px;
    height: 190px;
    border-radius: 50%;
    background: rgba(89, 225, 203, 0.08);
    filter: blur(8px);
  }

  .capability-card-home {
    grid-column: span 7;
    background:
      linear-gradient(135deg, rgba(89, 225, 203, 0.12), rgba(255, 255, 255, 0.02)),
      var(--bg-panel-strong);
  }

  .capability-card-home::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 34px 34px;
    mask-image: linear-gradient(145deg, rgba(0, 0, 0, 0.95), transparent 86%);
    pointer-events: none;
  }

  .capability-card-queue {
    grid-column: span 5;
    background:
      radial-gradient(circle at top right, rgba(89, 225, 203, 0.12), transparent 38%),
      var(--bg-panel);
  }

  .capability-card-handoff {
    grid-column: span 4;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
      var(--bg-panel);
  }

  .capability-card-quotes {
    grid-column: span 3;
    background:
      linear-gradient(160deg, rgba(89, 225, 203, 0.1), transparent 46%),
      var(--bg-elev);
  }

  .capability-card-fabric {
    grid-column: span 5;
    background:
      linear-gradient(135deg, rgba(89, 225, 203, 0.08), transparent 48%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0)),
      var(--bg-panel-strong);
  }

  .capability-card-recovery {
    grid-column: span 12;
    min-height: 0;
    background:
      linear-gradient(90deg, rgba(89, 225, 203, 0.12), rgba(89, 225, 203, 0)),
      var(--bg-panel);
  }

  .process-flow {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }

  .process-item {
    position: relative;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border-strong);
    min-height: 180px;
  }

  .process-item::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 42px;
    height: 1px;
    background: var(--accent);
  }

  .step-cmd {
    display: inline-flex;
    color: var(--text);
    background: var(--code-bg);
    border: 1px solid rgba(124, 166, 187, 0.16);
    padding: 0.24rem 0.55rem;
    border-radius: 999px;
    font-size: 0.92rem;
    margin-bottom: 0.9rem;
  }

  .process-item h3 {
    font-size: 1.2rem;
    margin-bottom: 0.55rem;
  }

  .skill-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.88fr);
    gap: 1.2rem;
    align-items: start;
  }

  .skill-copy {
    padding-top: 0.35rem;
  }

  .skill-list {
    display: grid;
    gap: 0.95rem;
    margin-top: 1.4rem;
  }

  .skill-list p {
    padding-left: 1rem;
    border-left: 1px solid rgba(124, 166, 187, 0.24);
  }

  .terminal {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }

  .term-bar {
    display: flex;
    gap: 0.5rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }

  .term-bar span {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #284052;
  }

  .terminal pre {
    margin: 0;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .prompt {
    color: var(--accent);
  }

  .ok {
    color: var(--accent);
  }

  .dim {
    color: var(--text-faint);
  }

  .reliability-layout {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) minmax(0, 1.2fr);
    gap: 1rem;
    align-items: start;
  }

  .command-stack {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.025), rgba(255, 255, 255, 0)),
      var(--bg-elev);
    overflow: hidden;
  }

  .command-row {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1rem 1.1rem;
    border-bottom: 1px solid rgba(124, 166, 187, 0.12);
  }

  .command-row:last-child {
    border-bottom: 0;
  }

  .command-row span {
    color: var(--text-dim);
    font-size: 0.92rem;
  }

  .command-row code {
    color: var(--text);
    font-size: 0.96rem;
  }

  .reliability-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .reliability-card {
    min-height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-panel);
  }

  .footer {
    border-top: 1px solid rgba(124, 166, 187, 0.14);
    margin-top: 1rem;
    padding-block: 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--text-dim);
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-stage::after {
      animation: stage-sweep 7s ease-in-out infinite;
    }

    .hero-copy,
    .hero-stage,
    .demo-frame,
    .capability-grid,
    .process-flow,
    .skill-layout,
    .reliability-layout {
